---
import shanghaiLogo from '../../dist/media/brand/shanghai-ai-lab.webp';
import internRoboticsLogo from '../../dist/media/brand/internrobotics.webp';
---

<header class="header">
  <div class="brand-lockup" aria-label="Shanghai AI Laboratory and InternRobotics">
    <a
      class="institution-brand shanghai-ai-brand"
      href="https://www.shlab.org.cn/"
      target="_blank"
      rel="noopener"
      aria-label="Shanghai AI Laboratory official website"
    >
      <img
        src={shanghaiLogo.src}
        width="10875"
        height="1275"
        alt="Shanghai Artificial Intelligence Laboratory"
      />
    </a>
    <span class="brand-divider" aria-hidden="true"></span>
    <a
      class="institution-brand internrobotics-brand"
      href="https://internrobotics.shlab.org.cn/"
      target="_blank"
      rel="noopener"
      aria-label="InternRobotics official website"
    >
      <img src={internRoboticsLogo.src} width="3062" height="490" alt="InternRobotics" />
    </a>
  </div>
  <nav aria-label="Primary navigation">
    <a href="#overall">Results</a>
    <a href="#findings">Findings</a>
    <a href="#cases">Case Studies</a>
    <a href="#conclusion">Conclusion and Insights</a>
  </nav>
</header>

<style>
  @layer components {
    .header {
      position: sticky;
      top: 0;
      z-index: 60;
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 1rem;
      min-height: var(--header-height);
      background: var(--deep);
      color: #e0e7f1;
      padding: 0.75rem var(--gutter);
    }

    .brand-lockup {
      display: flex;
      align-items: center;
      gap: 1.3rem;
      min-width: 0;
      flex: 0 1 32rem;
      width: 32rem;
      max-width: 100%;
    }

    .institution-brand {
      display: block;
      min-width: 0;
    }

    .shanghai-ai-brand {
      flex: 0 1 15.75rem;
      width: 15.75rem;
    }

    .internrobotics-brand {
      flex: 0 1 13.5rem;
      width: 13.5rem;
    }

    .brand-lockup img {
      width: 100%;
      height: auto;
      max-height: 2.5rem;
      object-fit: contain;
    }

    .brand-divider {
      height: 1.8rem;
      width: 1px;
      background: #526078;
      flex: none;
    }

    .header nav {
      display: flex;
      flex: none;
      margin-left: auto;
      gap: 1.5rem;
      align-items: center;
      flex-wrap: wrap;
      justify-content: end;
      font-size: 1.125rem;
    }

    .header nav a {
      color: #d6dfef;
      white-space: nowrap;
    }

    .header nav a[aria-current] {
      color: white;
      text-decoration: underline;
    }
    @media (max-width: 85rem) {
      .header {
        padding-inline: 0.75rem;
        gap: 0.75rem;
      }
      .header nav {
        display: none;
      }
    }
    @media (max-width: 40rem) {
      .brand-lockup {
        gap: 0.75rem;
      }
    }
    @media print {
      .header {
        display: none;
      }
    }
  }
</style>
