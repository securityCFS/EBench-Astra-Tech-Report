---
import { icon } from '../lib/icons.js';
---

<div class="contents-toolbar">
  <button
    class="toc-toggle"
    type="button"
    aria-label="Toggle Contents"
    aria-expanded="true"
    aria-controls="report-toc-links"
  >
    <Fragment set:html={icon('menu')} />
    <span>Contents</span>
  </button>
</div>
<aside class="report-toc" aria-label="Report contents">
  <nav id="report-toc-links" aria-label="On this page">
    <p class="toc-title">Contents</p>
    <a href="#introduction">Opening</a>
    <a href="#overall">
      <span class="toc-number">01</span> <span class="toc-label">Benchmark Results</span>
    </a>
    <a href="#model-references" class="toc-subsection">
      <span class="toc-number" aria-hidden="true"></span>{' '}
      <span class="toc-label">Model References</span>
    </a>
    <a href="#setup">
      <span class="toc-number">02</span> <span class="toc-label">Experiment Setup</span>
    </a>
    <a href="#evaluation-tasks" class="toc-subsection">
      <span class="toc-number" aria-hidden="true"></span>{' '}
      <span class="toc-label">Evaluation tasks</span>
    </a>
    <a href="#adaptation-protocol" class="toc-subsection">
      <span class="toc-number" aria-hidden="true"></span>{' '}
      <span class="toc-label">Adaptation and protocol</span>
    </a>
    <a href="#observations-control" class="toc-subsection">
      <span class="toc-number" aria-hidden="true"></span>{' '}
      <span class="toc-label">Observations and control</span>
    </a>
    <a href="#comparison">
      <span class="toc-number">03</span> <span class="toc-label">Score and Ranking</span>
    </a>
    <a href="#findings">
      <span class="toc-number">04</span> <span class="toc-label">General Analysis</span>
    </a>
    <a href="#mobile" class="toc-subsection">
      <span class="toc-number" aria-hidden="true"></span>{' '}
      <span class="toc-label">Capability Differences</span>
    </a>
    <a href="#limits" class="toc-subsection">
      <span class="toc-number" aria-hidden="true"></span>{' '}
      <span class="toc-label">Failure Patterns</span>
    </a>
    <a href="#behavior" class="toc-subsection">
      <span class="toc-number" aria-hidden="true"></span>{' '}
      <span class="toc-label">Adaptive Capabilities</span>
    </a>
    <a href="#safety" class="toc-subsection">
      <span class="toc-number" aria-hidden="true"></span>{' '}
      <span class="toc-label">Safety in Execution</span>
    </a>
    <a href="#cases">
      <span class="toc-number">05</span> <span class="toc-label">Case Studies</span>
    </a>
    <a href="#case-icl" class="toc-subsection">
      <span class="toc-number" aria-hidden="true"></span>{' '}
      <span class="toc-label">In-Context Learning</span>
    </a>
    <a href="#case-adapt" class="toc-subsection">
      <span class="toc-number" aria-hidden="true"></span>{' '}
      <span class="toc-label">Adaptation And Precision</span>
    </a>
    <a href="#case-poc">
      <span class="toc-number">06</span> <span class="toc-label">Compositional Generalization</span>
    </a>
    <a href="#case-poc-setting" class="toc-subsection">
      <span class="toc-number" aria-hidden="true"></span>{' '}
      <span class="toc-label">Evaluation Setting</span>
    </a>
    <a href="#case-poc-analysis" class="toc-subsection">
      <span class="toc-number" aria-hidden="true"></span>{' '}
      <span class="toc-label">Atomic Task Execution</span>
    </a>
    <a href="#conclusion">
      <span class="toc-number">07</span> <span class="toc-label">Conclusion And Insights</span>
    </a>
    <a href="#related-work">
      <span class="toc-number">08</span> <span class="toc-label">Related Work</span>
    </a>
    <a href="#references">
      <span class="toc-number">09</span> <span class="toc-label">References</span>
    </a>
  </nav>
</aside>

<style>
  @layer components {
    .contents-toolbar {
      position: sticky;
      top: var(--header-offset, var(--header-height));
      z-index: 55;
      display: flex;
      align-items: center;
      height: var(--toc-toolbar-height);
      padding-inline: var(--gutter);
      border-bottom: 1px solid var(--line);
      background: var(--paper);
    }
    .toc-toggle {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;
      min-height: 2.75rem;
      padding: 0.4rem 0.5rem;
      border: 0;
      border-radius: var(--radius-sm);
      background: transparent;
      color: var(--muted);
      font-size: 0.9375rem;
    }
    .toc-toggle:hover {
      background: var(--soft);
      color: var(--ink);
    }
    .toc-toggle :global(svg) {
      width: 1.375rem;
      height: 1.375rem;
      stroke-width: 1.5;
    }
    .report-toc {
      position: fixed;
      inset: calc(var(--header-offset, var(--header-height)) + var(--toc-toolbar-height)) auto 0 0;
      width: min(var(--rail-width), 100%);
      z-index: 50;
      overflow-y: auto;
      overscroll-behavior: contain;
      background: #eef1f6f5;
      border-right: 1px solid var(--line);
      padding: 1.25rem 0.75rem;
      transform: translateX(0);
      visibility: visible;
      transition:
        transform var(--toc-duration) var(--motion-ease),
        visibility 0s;
    }

    .report-toc nav {
      display: flex;
      flex-direction: column;
      gap: 0.15rem;
    }

    .report-toc a {
      display: grid;
      grid-template-columns: 2rem minmax(0, 1fr);
      column-gap: 0.5rem;
      color: var(--muted);
      font-size: 1.125rem;
      line-height: 1.4;
      padding: 0.6rem 0.75rem;
      border-left: 2px solid transparent;
      text-align: left;
      white-space: nowrap;
    }

    .toc-number {
      font-variant-numeric: tabular-nums;
    }

    .report-toc a[href='#introduction'] {
      display: block;
    }

    .report-toc a[aria-current] {
      background: var(--accent-soft);
      border-color: var(--accent);
      font-weight: 700;
      color: #3049b7;
    }

    .report-toc .toc-subsection {
      padding-left: 1.6rem;
    }

    .toc-title {
      display: none;
    }

    :global(body[data-toc-open='false']) .report-toc {
      transform: translateX(-100%);
      visibility: hidden;
      pointer-events: none;
      transition-delay: 0s, var(--toc-duration);
    }
    @media (max-width: 85rem) {
      .contents-toolbar {
        padding-inline: 0.75rem;
      }
      :global(body:not([data-toc-ready])) .report-toc {
        transform: translateX(-100%);
        visibility: hidden;
      }
      .report-toc {
        box-shadow: 1rem 0 2rem #15234020;
      }
    }
    @media print {
      .contents-toolbar,
      .report-toc {
        display: none;
      }
    }
  }
</style>
