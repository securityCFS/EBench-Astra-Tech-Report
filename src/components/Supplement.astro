---
import { icon } from '../lib/icons.js';
import '../styles/supplement.css';
---

<dialog id="appendix-dialog" class="report-supplement" aria-labelledby="appendix-title">
  <header class="dialog-heading">
    <span class="supplement-eyebrow">
      <Fragment set:html={icon('book-open')} />
      Supplementary material
    </span>
    <button
      type="button"
      class="close-dialog"
      aria-label="Close supplementary material"
      title="Close supplementary material (Escape)"
      autofocus
    >
      <Fragment set:html={icon('x')} />
    </button>
  </header>
  <div id="appendix-body" role="region" aria-labelledby="appendix-title" tabindex="0"></div>
</dialog>
