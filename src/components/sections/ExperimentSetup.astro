    margin-block: 2.75rem 0;
    text-align: left;
    scroll-margin-top: calc(var(--header-height) + 1.5rem);
  }
  .setup-subsection > h3 {
    margin: 0 0 1.25rem;
    font-size: 1.875rem;
  }
  .setup-subsection > h4 {
    margin: 1.75rem 0 0.875rem;
    font-size: 1.5rem;
    font-weight: 600;
  }
  .reasoning-effort-highlight {
    background-color: #5b616b;
    color: #fff;
    padding: 0.1em 0.3em;
    border-radius: 0.2em;
  }
</style>
