---
import '@fontsource/stix-two-text/400.css';
import '@fontsource/stix-two-text/500.css';
import '@fontsource/stix-two-text/600.css';
import '@fontsource/stix-two-text/700.css';
import '@fontsource/stix-two-text/400-italic.css';
import 'katex/dist/katex.min.css';
import '../styles/report.css';
import SiteHeader from '../components/SiteHeader.astro';
import Contents from '../components/Contents.astro';
import Masthead from '../components/Masthead.astro';
import ReportFooter from '../components/ReportFooter.astro';
import Supplement from '../components/Supplement.astro';

interface Props {
  title?: string;
  description?: string;
}
const {
  title = 'How Far Does a Frontier Agent Get as an Embodied Policy?',
  description = 'Evaluation of GPT-6-Astra on EBench: benchmark comparisons, embodied capabilities, and recorded execution evidence.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <script>
      import 'virtual:report-runtime';
    </script>
  </head>
  <body data-toc-open="true">
    <a class="skip-link" href="#introduction">
      Skip to report
    </a>
    <!-- <canvas id="ambient-particles" aria-hidden="true"></canvas> -->
    <SiteHeader />
    <Contents />
    <div class="report-page">
      <Masthead />
      <main>
        <slot />
      </main>
      <ReportFooter />
    </div>
    <Supplement />
  </body>
</html>
